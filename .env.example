# Copy to .env (never commit .env). Every value below is a local-only example.
ENVIRONMENT=local
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinicared_db
DB_USER=postgres
DB_PASSWORD=change-me-local-only
DB_SSLMODE=disable

RABBITMQ_USER=clinicared
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_URL=amqp://clinicared:change-me-local-only@localhost:5672/clinicared

MESSAGING_GATEWAY_URL=http://backend:8000/simulate/messaging/send
MESSAGING_GATEWAY_TOKEN=
WEBHOOK_SIGNING_SECRET=change-me-local-only-webhook-secret
# >= 32 chars. In AWS it lives in Secrets Manager (clinicared/pseudonymization-pepper).
PSEUDONYMIZATION_PEPPER=change-me-local-only-pepper-0123456789

OVERBOOK_BLOCK_MINUTES=60

# Airflow (docker-compose only)
AIRFLOW_DB_PASSWORD=change-me-local-only
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
AIRFLOW_FERNET_KEY=
# Airflow 3: shared by api-server, scheduler, dag-processor and workers (Task Execution API JWTs).
AIRFLOW_JWT_SECRET=change-me-local-only-jwt-secret-0123456789
AIRFLOW_API_SECRET_KEY=change-me-local-only-api-secret-0123456789
